{
  "Database": {
    "Provider": "Sqlite"
  },
  "Deployment": {
    "AvailableDbProviders": [ "Sqlite", "Postgres" ]
  },
  "Plugins": {
    "Enabled": false,
    "Directory": "plugins"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/election.db",
    "Postgres": "Host=localhost;Port=5432;Database=eems;Username=eems_user;Password=changeme"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "UserName": "vetox.elections@gmail.com",
    "Password": "yrbhgyuibhgoxrtg",
    "EnableSsl": "true",
    "FromEmail": "vetox.elections@gmail.com"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Jwt": {
    "Issuer": "ElectionSystem.Api",
    "Audience": "ElectionSystem.Web",
    "ExpiresInMinutes": 60,
    "Key": "this_is_a_very_secret_key_for_jwt_which_should_be_long_enough"
  },
  "AllowedHosts": "*"
}