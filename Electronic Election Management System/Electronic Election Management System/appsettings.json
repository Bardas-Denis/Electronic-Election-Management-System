{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=election.db"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "UserName": "your_email@gmail.com",
    "Password": "your_app_password",
    "EnableSsl": "true",
    "FromEmail": "your_email@gmail.com"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "ElectionSystem.Api",
    "Audience": "ElectionSystem.Web",
    "ExpiresInMinutes": 60,
    "Key": "this_is_a_very_secret_key_for_jwt_which_should_be_long_enough"
  },
  "AllowedHosts": "*"
}
